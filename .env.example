# Required
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Stable model suitable for this student project
GEMINI_MODEL=gemini-2.5-flash

# Default is false because the cloud Gemini path is simpler to install.
# Set true only if you install requirements-local.txt.
USE_LOCAL_EXPLANATION=false
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
